{
	"version": 3,
	"configurePresets": [
		{
			"name": "vr-mo2",
			"displayName": "VR — deploy DLL/PDB into an MO2 mod folder (recommended for MO2 users)",
			"inherits": "windows-vcpkg-vr",
			"cacheVariables": {
				"MO2_INSTALL_PATH": "C:/MO2/Fallout4VR/mods/starterplugin/F4SE/Plugins"
			}
		},
		{
			"name": "vr-copy",
			"displayName": "VR — copy into the game's real Data/F4SE/Plugins (non-MO2 installs)",
			"inherits": "windows-vcpkg-vr",
			"cacheVariables": {
				"COPY_BUILD": true
			},
			"environment": {
				"FalloutVRPath": "C:/Steam/steamapps/common/Fallout 4 VR"
			}
		}
	]
}
