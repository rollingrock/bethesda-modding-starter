.vs/
*.user

# Per-machine state written by the setup scripts. All of it is absolute paths, PIDs or
# logs for THIS box, so committing it would hand the next machine stale nonsense.
setup/.ghidra-mcp-build.json
setup/.ghidra-headless-cp.txt
setup/.ghidra-headless.pid
setup/.ghidra-headless.*.pid
setup/.ghidra-headless.*.load.json
setup/.ghidra-headless.*.log
setup/.analysis-verified.json

# Generated by 36-ghidra-mcp.ps1 -WriteMcpConfigTo; belongs to the project you point it at.
.mcp.json

# Python bytecode (probe_bridge.py is run directly; nothing here should be committed)
__pycache__/
*.pyc

# apply_prototypes.py working cache (per-machine: absolute paths, addresses, journals)
ghidra-scripts/.proto-cache/
